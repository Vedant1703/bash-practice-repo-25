#!/usr/bin/env bash

# Generate secure passwords with visual feedback
# Usage: ./password_generator.sh [length]

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

generate_password() {
    local length="$1"
    local password=""
    local char_classes=(
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        "abcdefghijklmnopqrstuvwxyz"
        "0123456789"
        "!@#$%^&*()_+-=[]{}|;:,.<>?~"
    )

    # Validate input
    if [[ ! "$length" =~ ^[0-9]+$ ]]; then
        echo -e "${RED}Error: Password length must be a number${NC}" >&2
        return 1
    fi

    if [[ "$length" -lt 8 ]]; then
        echo -e "${YELLOW}Warning: For security, consider using at least 8 characters${NC}" >&2
    fi

    # Ensure at least one character from each class
    echo -e "${GREEN}Generating password with:${NC}"
    echo -e " - Uppercase letters (A-Z)"
    echo -e " - Lowercase letters (a-z)"
    echo -e " - Numbers (0-9)"
    echo -e " - Special characters (!@# etc.)"

    for class in "${char_classes[@]}"; do
        password+="${class:$((RANDOM % ${#class})):1}"
    done

    # Fill remaining length
    while [[ ${#password} -lt "$length" ]]; do
        local random_class="${char_classes[$((RANDOM % ${#char_classes[@]}))]}"
        password+="${random_class:$((RANDOM % ${#random_class})):1}"
    done

    # Shuffle the password
    password=$(echo "$password" | fold -w1 | shuf | tr -d '\n')

    # Visual feedback
    echo -e "\n${GREEN}✔ Password generated successfully${NC}"
    return 0
}

# Main execution
if [[ $# -eq 0 ]]; then
    echo -e "${YELLOW}Usage: $0 <password_length>${NC}"
    echo -e "Example: $0 12"
    exit 1
fi

echo -e "\n${YELLOW}=== Password Generator ===${NC}"
password=$(generate_password "$1")

if [[ $? -eq 0 ]]; then
    echo -e "\n${GREEN}Your new password:${NC}"
    echo -e "▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
    echo -e "${YELLOW}$password${NC}"
    echo -e "▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬"
    
    # Calculate estimated strength
    if [[ "$1" -ge 12 ]]; then
        echo -e "${GREEN}Strength: Excellent (≥12 characters)${NC}"
    elif [[ "$1" -ge 8 ]]; then
        echo -e "${GREEN}Strength: Good (8-11 characters)${NC}"
    else
        echo -e "${YELLOW}Strength: Weak (<8 characters)${NC}"
    fi
fi
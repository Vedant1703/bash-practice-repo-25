#!/usr/bin/env bash

# Download YouTube video between specified timestamps
# Usage: youtube-time <start_time> <end_time> <output_file> <url>
# Example: youtube-time 2:00 4:00 tutorial.mkv "https://youtube.com/watch?v=..."

set -euo pipefail

# Check dependencies
for cmd in yt-dlp ffmpeg; do
    if ! command -v "$cmd" &> /dev/null; then
        echo "Error: $cmd not installed. Install with:"
        echo "  pip install yt-dlp && sudo apt install ffmpeg"
        exit 1
    fi
done

# Validate arguments
if [[ $# -ne 4 ]]; then
    echo "Usage: $0 <start_time> <end_time> <output_file> <url>"
    echo "Example: $0 2:00 4:00 output.mp4 'https://youtube.com/watch?v=...'"
    exit 1
fi

start_time="$1"
end_time="$2"
output_file="$3"
url="$4"

# Temporary file
temp_file="$(mktemp --suffix=.mp4)"

# Cleanup function
cleanup() {
    rm -f "$temp_file"
}
trap cleanup EXIT

echo "⌛ Downloading video..."
yt-dlp \
    --quiet --no-warnings \
    --output "$temp_file" \
    --format "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" \
    "$url"

echo "✂️ Trimming from $start_time to $end_time..."
ffmpeg \
    -hide_banner -loglevel error \
    -ss "$start_time" \
    -to "$end_time" \
    -i "$temp_file" \
    -c:v copy -c:a copy \
    "$output_file"

echo "✅ Saved to: $output_file"